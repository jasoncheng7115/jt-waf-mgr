[Unit]
Description=jt-waf-mgr: ask the internal and external DNS servers about the site names; PTR names of outside addresses
Documentation=file:///usr/lib/jt-waf-mgr/README.md
After=network-online.target
Wants=network-online.target
# The web service never asks DNS; only this short-lived job does (UDP / TCP 53 to the servers the admin entered,
# or the host's resolvers for PTR names), and it can only write its own directory.

[Service]
Type=oneshot
User=jtwaf
Group=jtwaf
Environment=PYTHONPATH=/usr/lib/jt-waf-mgr
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -m jtwafmgr --config /etc/jt-waf-mgr/config.toml dns-check
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/jt-waf-mgr/dns
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
MemoryMax=256M
CPUQuota=50%
