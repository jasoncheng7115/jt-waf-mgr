<!--
  jt-waf-mgr: decoders (draft for a Wazuh rule pack; range 133560-133589)
  Copyright Jason Tools Co., Ltd. / AGPL-3.0-or-later

  jt-waf-mgr sends every audit row and every chain anchor to syslog (facility local0 by default) as
  one JSON object under the program name jt-waf-mgr:

    <syslog header> jt-waf-mgr: {"jt_waf_mgr":{"v":1,"action":"login","actor":"alice","actor_type":"user",
        "src_ip":"192.0.2.10","result":"ok","node_id":"waf1","ts":"...","audit_id":6,"hash":"..."}}
    <syslog header> jt-waf-mgr: {"jt_waf_mgr":{"v":1,"kind":"audit_anchor","node_id":"waf1","id":12,"hash":"...","count":12}}

  An agent that reads /var/log/syslog (or journald) on the jt-waf-mgr host already sends these lines.
  Measured with wazuh-logtest 4.14.10: no built-in decoder claims the program name, so the JSON plugin
  decoder below gets every line.
-->
<decoder name="jt-waf-mgr">
  <program_name>^jt-waf-mgr$</program_name>
</decoder>

<decoder name="jt-waf-mgr-json">
  <parent>jt-waf-mgr</parent>
  <prematch>^{"jt_waf_mgr":</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>
