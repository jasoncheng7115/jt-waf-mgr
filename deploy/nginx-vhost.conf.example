# Management vhost for jt-waf-mgr. Internal networks only.
# Copy to your vhost directory, adjust server_name / certificates / allowed networks,
# then: nginx -t && systemctl reload nginx
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name waf.example.com;

    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    # Internal networks only (or narrower: your admin network).
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    # Do not run the WAF on its own management UI: event filters and rule texts contain
    # attack strings by nature, and would show up as events of their own.
    modsecurity off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # Optional brute-force brake in front of the service's own limits (needs, in the http block:
    #   limit_req_zone $binary_remote_addr zone=jtwaf_login:1m rate=10r/m;)
    # location = /api/v1/auth/login {
    #     limit_req zone=jtwaf_login burst=5 nodelay;
    #     proxy_pass http://127.0.0.1:8095;
    #     proxy_set_header Host $http_host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For "";
    # }

    location / {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;          # the CSRF Origin check compares against it
        proxy_set_header X-Real-IP $remote_addr;   # trusted only from 127.0.0.1
        proxy_set_header X-Forwarded-For "";
        proxy_read_timeout 60s;
    }

    access_log /var/log/nginx/waf-mgr.access.log;
    error_log  /var/log/nginx/waf-mgr.error.log;
}
