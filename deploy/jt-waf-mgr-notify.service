[Unit]
Description=jt-waf-mgr: send queued notifications (e-mail, Telegram, Teams, Slack, Discord, Zulip, Nextcloud Talk, webhook)
Documentation=file:///usr/lib/jt-waf-mgr/README.md
After=network-online.target
Wants=network-online.target
# A short-lived job: reads the queued notifications from the database, sends each to its channel, records the
# result and reminds open alerts. The web service only queues them (it never connects out). It never changes
# the WAF. Chat services are on the internet, so this unit cannot be limited to the local network; it has no
# other privilege than reading the settings and writing the notification rows.

[Service]
Type=oneshot
User=jtwaf
Group=jtwaf
Environment=PYTHONPATH=/usr/lib/jt-waf-mgr
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -m jtwafmgr --config /etc/jt-waf-mgr/config.toml notify-run
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
# the database (notification rows, failure audit rows) and the "send now" request file
ReadWritePaths=/var/lib/jt-waf-mgr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=256M
CPUQuota=25%
